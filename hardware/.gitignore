# ==========================================
# 📐 Hardware Design Tools (KiCad)
# ==========================================

# --- KiCad Specifics ---
# Backup files
.*.bak
*.bak
*.bck
*.kicad_pcb-bak
*.sch-bak
*.kicad_sch-bak
*.kicad_pro-bak
*-backups/
.history/

# Cache and local session settings
*.wbk
fp-info-cache
_autosave-*
*.lock
*.lck
*.kicad_prl

# Unrouted layout saving state
*.unrouted

# Local Workspace settings
/__Previews/
*.PcbDoc.htm
*.SchDoc.htm

# ==========================================
# 📦 Exceptions (Keep Production Outputs)
# ==========================================
# Explicitly force tracking of final manufacturing files in production/
!/production/**/*.pdf
!/production/**/*.zip
!/production/**/*.csv
!/production/**/*.txt

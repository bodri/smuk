(module Heatsink_Fischer_SK96-84SA_2Fixations (layer F.Cu) (tedit 6127EB52)
  (descr "Heatsink, 55x84mm, 2 fixations M3")
  (tags "Heatsink sheet")
  (solder_mask_margin 0.2)
  (fp_text reference REF** (at 0 -6) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value Heatsink_Fischer_SK96-84SA_2Fixations (at 0 6) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start 0 4) (end 42 4) (layer F.SilkS) (width 0.12))
  (fp_line (start 42 4) (end 42 -4) (layer F.SilkS) (width 0.12))
  (fp_line (start 42 -4) (end -42 -4) (layer F.SilkS) (width 0.12))
  (fp_line (start -42 -4) (end -42 4) (layer F.SilkS) (width 0.12))
  (fp_line (start -42 4) (end 0 4) (layer F.SilkS) (width 0.12))
  (fp_line (start 42.1 4.1) (end 42.1 -4.1) (layer F.CrtYd) (width 0.12))
  (fp_line (start 42.1 -4.1) (end -42.1 -4.1) (layer F.CrtYd) (width 0.12))
  (fp_line (start -42.1 -4.1) (end -42.1 4.1) (layer F.CrtYd) (width 0.12))
  (fp_line (start -42.1 4.1) (end 42.1 4.1) (layer F.CrtYd) (width 0.12))
  (pad 1 thru_hole circle (at 30 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask))
  (pad 1 thru_hole circle (at -30 0) (size 6 6) (drill 3.2) (layers *.Cu *.Mask))
  (model ${KISYS3DMOD}/Heatsink.3dshapes/Heatsink_SheetType_50x7mm_2Fixations.wrl
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
